<?xml version="1.0" encoding="utf-8"?>
<!-- Cloud backup excludes the note database (P2-17 fix — see backup_rules.xml).
     Direct device-to-device transfer KEEPS the database: that is a deliberate,
     user-initiated migration between the user's own devices. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="noteflow.db" />
        <exclude domain="database" path="noteflow.db-wal" />
        <exclude domain="database" path="noteflow.db-shm" />
        <include domain="file" path="datastore/" />
        <exclude domain="sharedpref" path="com.google.firebase.auth" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="noteflow.db" />
        <include domain="file" path="datastore/" />
        <exclude domain="sharedpref" path="com.google.firebase.auth" />
    </device-transfer>
</data-extraction-rules>
